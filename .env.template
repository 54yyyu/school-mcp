# Each school is a named account. Define one block per school, using the
# uppercased account name as the variable prefix.

# Active account name (lowercase), e.g. columbia or mit
SCHOOL_ACCOUNT=your_account_name

# ---------------------------------------------------------------
# Example account: COLUMBIA  -> account name "columbia"
# ---------------------------------------------------------------
COLUMBIA_CANVAS_ACCESS_TOKEN=your_canvas_token_here
COLUMBIA_CANVAS_DOMAIN=canvas.your_institution.edu
# Gradescope is optional - omit both lines for accounts that don't use it
COLUMBIA_GRADESCOPE_EMAIL=your_email@your_institution.edu
COLUMBIA_GRADESCOPE_PASSWORD=your_gradescope_password

# ---------------------------------------------------------------
# Example account: MIT  -> account name "mit"
# ---------------------------------------------------------------
MIT_CANVAS_ACCESS_TOKEN=your_canvas_token_here
MIT_CANVAS_DOMAIN=canvas.mit.edu

# Optional: Default download path for Canvas files
# DOWNLOAD_PATH=/path/to/downloads

# Optional: Debug mode
# DEBUG=True
